---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { GridPattern } from '../magicui/grid-pattern'
import AnnotatedShot, { type Mark } from './AnnotatedShot.astro'

interface Props {
  src: ImageMetadata
  alt: string
  caption?: string
  // text: reading column · wide: beyond the text · full: edge to edge
  size?: 'text' | 'wide' | 'full'
  // Places a UI screenshot on a canvas instead of bare on the page
  framed?: boolean
  // Redlines the element the caption is about; the grid only appears under
  // a screenshot that is actually being measured
  mark?: Mark
}

const { src, alt, caption, size = 'wide', framed = false, mark } = Astro.props

const widths = { text: 'max-w-[46rem]', wide: 'max-w-[1360px]', full: 'max-w-none' }
const sizes = size === 'text' ? '(min-width: 768px) 736px, 100vw' : '(min-width: 1360px) 1280px, 100vw'
---

<figure class:list={['mx-auto my-16 sm:my-20', size === 'full' ? 'px-0' : 'px-5 sm:px-10', widths[size]]}>
  {framed ? (
    <div class:list={['canvas p-4 sm:p-10', mark && 'pb-16 sm:pb-20']}>
      {mark && <GridPattern width={24} height={24} />}
      <AnnotatedShot src={src} alt={alt} sizes={sizes} mark={mark} />
    </div>
  ) : mark ? (
    <div class="overflow-hidden rounded-2xl border border-rule">
      <AnnotatedShot src={src} alt={alt} sizes={sizes} mark={mark} rounded={false} />
    </div>
  ) : (
    <div class:list={[size !== 'full' && 'overflow-hidden rounded-2xl border border-rule']}>
      <Image src={src} alt={alt} widths={[640, 1024, 1600, 2400]} sizes={sizes} class="h-auto w-full" />
    </div>
  )}
  {caption && (
    <figcaption class="mx-auto mt-4 max-w-[44rem] text-[0.875rem] leading-relaxed text-ink-3">
      {caption}
    </figcaption>
  )}
</figure>
