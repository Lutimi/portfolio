---
// A screenshot with one redline on it: the element its caption or outcome
// line is about, boxed, dimensioned and named. Positions are percentages of
// the image, so the mark scales with it.
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

export interface Mark {
  x: number
  y: number
  w: number
  h: number
  label: string
  align?: 'left' | 'right'
}

interface Props {
  src: ImageMetadata
  alt: string
  sizes: string
  mark?: Mark
  rounded?: boolean
  loading?: 'eager' | 'lazy'
}

const { src, alt, sizes, mark, rounded = true, loading = 'lazy' } = Astro.props
---

<div class="shot relative">
  <Image
    src={src}
    alt={alt}
    widths={[640, 1024, 1600, 2400]}
    sizes={sizes}
    loading={loading}
    class:list={['relative block h-auto w-full', rounded && 'rounded-xl shadow-[0_18px_40px_-20px_rgb(21_21_21/0.35)]']}
  />
  {mark && (
    <div class:list={['mark', mark.align === 'right' && 'mark--right']} style={`left:${mark.x}%;top:${mark.y}%;width:${mark.w}%;height:${mark.h}%;--room:${mark.align === 'right' ? mark.x + mark.w : 100 - mark.x}`} aria-hidden="true">
      <svg class="mark-dim" viewBox="0 0 100 10" preserveAspectRatio="none">
        <path d="M0 0V10M0 5H100M100 0V10" vector-effect="non-scaling-stroke" />
      </svg>
      <span class="mark-leader"></span>
      <span class="mark-label">{mark.label}</span>
    </div>
  )}
</div>

<style>
  /* The shot is a size container so each label knows how much room it has
     toward its side, and wraps instead of running off the image */
  .shot {
    container-type: inline-size;
  }

  .mark {
    position: absolute;
    border: 1.5px solid var(--color-redline);
    border-radius: 4px;
    pointer-events: none;
  }

  .mark-dim {
    position: absolute;
    left: -1.5px;
    top: -16px;
    width: calc(100% + 3px);
    height: 10px;
    overflow: visible;
    fill: none;
    stroke: var(--color-redline);
    stroke-width: 1.5;
  }

  .mark-leader {
    position: absolute;
    top: 100%;
    left: 12px;
    width: 1.5px;
    height: 18px;
    background: var(--color-redline);
  }

  .mark-label {
    position: absolute;
    top: calc(100% + 18px);
    left: 0;
    padding: 0.2rem 0.5rem;
    border: 1px dashed var(--color-redline);
    border-radius: 6px;
    background: var(--color-paper);
    color: var(--color-redline);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.35;
    width: max-content;
    max-width: calc(var(--room) * 1cqw - 12px);
  }

  .mark--right .mark-leader {
    left: auto;
    right: 12px;
  }

  .mark--right .mark-label {
    left: auto;
    right: 0;
  }

  @media (min-width: 1024px) {
    .mark-label {
      font-size: 0.875rem;
    }
  }
</style>
