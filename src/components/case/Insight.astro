---
// The turning point of a chapter, set large between two dimension ticks
---

<aside class="mx-auto my-16 max-w-[46.5rem] px-5">
  <svg class="mb-6 h-3 w-full" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 1V11M0 6H100M100 1V11" fill="none" stroke="var(--color-redline)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
  </svg>
  <div class="heading text-[clamp(1.625rem,1.1rem+1.6vw,2.375rem)] leading-[1.15]">
    <slot />
  </div>
</aside>
