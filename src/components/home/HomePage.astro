---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import SiteHeader from '../site/SiteHeader.astro'
import TitleBlock from '../site/TitleBlock.astro'
import Hero from './Hero.astro'
import WorkGrid from './WorkGrid.astro'
import SpecHero from './SpecHero.astro'
import Websites from './Websites.astro'
import NamePress from '../figures/NamePress.astro'
import { homeContent } from '../../i18n/home'
import { homeUrl, type Lang } from '../../i18n/ui'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const c = homeContent(lang)
const otherLang: Lang = lang === 'en' ? 'es' : 'en'

const entries = (
  await getCollection('work', ({ id, data }) => id.startsWith(`${lang}/`) && (import.meta.env.DEV || !data.draft))
).sort((a, b) => a.data.order - b.data.order)
---

<Layout
  title={c.meta.title}
  description={c.meta.description}
  lang={lang}
  alternates={[
    { lang, href: homeUrl(lang) },
    { lang: otherLang, href: homeUrl(otherLang) },
  ]}
>
  <SiteHeader lang={lang} switchHref={homeUrl(otherLang)} />

  <main>
    <Hero hero={c.hero} lang={lang} />

    <!-- The case studies, then the websites I built, then the inspector for the parts -->
    <WorkGrid entries={entries} work={c.work} lang={lang} />

    <Websites webs={c.webs} />

    <SpecHero hero={c.hero} />

    <section class="mx-auto mt-32 max-w-[1360px] px-5 sm:px-10">
      <h2 class="heading border-t border-ink pt-5 text-[clamp(1.75rem,1.2rem+1.6vw,2.5rem)]">{c.process.heading}</h2>
      <!-- The naming rule from the Izipay design system, as a working machine -->
      <div class="mt-10"><NamePress lang={lang} /></div>
      <ol class="notes mt-14 grid gap-x-14 gap-y-12 md:grid-cols-2">
        {c.process.notes.map(note => (
          <li class="note">
            <h3 class="heading text-[1.5rem]">{note.title}</h3>
            <p class="mt-3 max-w-[34rem] text-ink-2">{note.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="about" class="mx-auto mt-32 max-w-[1360px] scroll-mt-20 px-5 sm:px-10">
      <h2 class="heading border-t border-ink pt-5 text-[clamp(1.75rem,1.2rem+1.6vw,2.5rem)]">{c.about.heading}</h2>
      <div class="mt-10 grid gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
        <div>
          <div class="space-y-5 text-[1.1875rem] leading-relaxed">
            {c.about.bio.map(paragraph => <p class="max-w-[36rem]">{paragraph}</p>)}
          </div>
        </div>
        <div class="space-y-10">
          <div>
            <h3 class="text-[0.8125rem] font-semibold text-ink-3">{c.about.experienceHeading}</h3>
            <dl class="timeline mt-3">
              {c.about.experience.map(item => (
                <div class="row">
                  <dt>{item.role}<span class="org">{item.org}</span></dt>
                  <dd class="tabular">{item.period}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div>
            <h3 class="text-[0.8125rem] font-semibold text-ink-3">{c.about.educationHeading}</h3>
            <dl class="timeline mt-3">
              {c.about.education.map(item => (
                <div class="row">
                  <dt>{item.role}<span class="org">{item.org}</span></dt>
                  <dd class="tabular">{item.period}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- The close: a sheet in ink on paper; red appears only as the
         dimension under the address -->
    <section class="mx-auto mt-32 max-w-[1360px] px-5 sm:px-10">
      <div class="close border border-ink px-6 py-14 sm:px-14 sm:py-20">
        <h2 class="display max-w-[14ch] text-[clamp(2.25rem,1rem+5.4vw,6rem)]">{c.close.title}</h2>
        <p class="mt-6 max-w-[34rem] text-[1.1875rem] leading-relaxed text-ink-2">{c.close.body}</p>
        <div class="mt-12 inline-flex max-w-full flex-col">
          <a href="mailto:lutimi19@gmail.com" class="close-mail display text-[clamp(1.625rem,0.6rem+3.6vw,4.25rem)] [font-stretch:110%]">lutimi19@gmail.com</a>
          <svg class="close-dim mt-3 h-3 w-full" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 1V11M0 6H100M100 1V11" fill="none" stroke="var(--color-redline)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
          </svg>
        </div>
        <ul class="mt-12 flex flex-wrap gap-3">
          <li><a class="button" href="mailto:lutimi19@gmail.com">{c.close.email}</a></li>
          <li><a class="button button--ghost" href="/cv-luis-ticona.pdf" target="_blank" rel="noopener">{c.close.resume} (PDF)</a></li>
          <li><a class="button button--ghost" href="https://github.com/Lutimi" target="_blank" rel="noopener">GitHub</a></li>
          <li><a class="button button--ghost" href="https://www.behance.net/luisticona1" target="_blank" rel="noopener">Behance</a></li>
        </ul>
      </div>
    </section>
  </main>

  <TitleBlock lang={lang} sheet={lang === 'en' ? 'Home' : 'Inicio'} />
</Layout>

<style>
  .note {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-rule);
  }

  .timeline .row {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .timeline .row:first-child {
    border-top: 1px solid var(--color-rule);
  }

  .timeline dt {
    font-weight: 600;
  }

  .timeline .org {
    display: block;
    font-weight: 400;
    color: var(--color-ink-2);
  }

  .timeline dd {
    flex-shrink: 0;
    color: var(--color-ink-2);
    font-size: 0.9375rem;
  }

  .close-mail {
    color: var(--color-ink);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 0.2s var(--ease-out-expo);
  }

  .close-mail:hover {
    color: var(--color-redline);
  }

</style>
